#!/bin/bash
# CineLink Bridge — macOS .app launcher
# Self-contained: Node.js runtime is embedded, nothing to install.

MACOS_DIR="${BASH_SOURCE[0]%/*}"
RESOURCES="$MACOS_DIR/../Resources"
NODE="$RESOURCES/node"
BRIDGE="$RESOURCES/bridge.cjs"

if [ ! -f "$NODE" ]; then
    osascript -e 'display alert "CineLink Bridge" message "Node.js runtime не найден внутри .app.\nПожалуйста, скачайте приложение заново." as critical'
    exit 1
fi

# Remove quarantine flag (first launch after download)
xattr -d com.apple.quarantine "$NODE" 2>/dev/null || true
xattr -d com.apple.quarantine "$BRIDGE" 2>/dev/null || true

# Pass paths as arguments to AppleScript.
osascript - "$NODE" "$BRIDGE" <<'APPLESCRIPT'
on run argv
    set nodePath to item 1 of argv
    set bridgePath to item 2 of argv
    set shellCmd to "exec " & quoted form of nodePath & " " & quoted form of bridgePath
    tell application "Terminal"
        activate
        set newWin to do script shellCmd
        set custom title of newWin to "CineLink Bridge β2"
        try
            set current settings of newWin to settings set "Pro"
        end try
    end tell
end run
APPLESCRIPT

# Wait for server to start, then open browser
sleep 2
open "http://localhost:7777"
