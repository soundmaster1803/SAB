#!/bin/bash
# CineLink Bridge — macOS .app launcher
# Self-contained: Node.js runtime is embedded, nothing to install.

MACOS_DIR="${BASH_SOURCE[0]%/*}"
BINARY="$MACOS_DIR/cinelink-bridge"

if [ ! -f "$BINARY" ]; then
    osascript -e 'display alert "CineLink Bridge" message "Бинарный файл не найден внутри .app.\nПожалуйста, скачайте приложение заново." as critical'
    exit 1
fi

# Remove macOS quarantine flag if present (first launch after download)
xattr -d com.apple.quarantine "$BINARY" 2>/dev/null || true
xattr -d com.apple.quarantine "${BASH_SOURCE[0]}" 2>/dev/null || true

# Open a Terminal window running the server
osascript <<APPLESCRIPT
tell application "Terminal"
    activate
    set newWin to do script "$BINARY"
    set custom title of newWin to "CineLink Bridge β2"
    try
        set current settings of newWin to settings set "Pro"
    end try
end tell
APPLESCRIPT

# Wait for server to start, then open browser
sleep 2
open "http://localhost:7777"
