  {
    "opcode": "0x9201",
    "name": "SDIO_Connect",
    "ptpVersion": "both",
    "category": "session",
    "parameters": [
      {"name": "PhaseType", "type": "uint32", "description": "1=Phase1, 2=Phase2, 3=Phase3"},
      {"name": "Reserved1", "type": "uint32", "description": "Always 0"},
      {"name": "Reserved2", "type": "uint32", "description": "Always 0"}
    ],
    "expectedResponse": "OK (0x2001). Phase 2 may return 0xA101 if already connected — this is expected.",
    "usedInSABRuntime": true,
    "canCallDirectly": true,
    "requiresSession": true,
    "requiresSequence": true,
    "affectsCameraState": false,
    "risk": "safe",
    "notes": "Must call Phase1 → Phase2 → GetExtDeviceInfo → Phase3 in sequence. SAB implements this as steps 6-9. Phase2 returning 0xA101 on ZV-E10 II is expected and not an error."
  },
  {
    "opcode": "0x9202",
    "name": "SDIO_GetExtDeviceInfo",
    "ptpVersion": "both",
    "category": "session",
    "parameters": [{"name": "Version", "type": "uint32", "description": "0x012C = PTP v3.00 (300 decimal)"}],
    "expectedResponse": "Extension version and supported property list",
    "usedInSABRuntime": true,
    "canCallDirectly": false,
    "requiresSession": true,
    "requiresSequence": true,
    "affectsCameraState": false,
    "risk": "safe",
    "notes": "Called between Phase2 and Phase3. Must use exactly 1 parameter (0x012C). SAB passes DATA_PHASE_NONE — the response is ignored currently."
  },
