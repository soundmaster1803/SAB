  {
    "opcode": "0x9207",
    "name": "SDIO_ControlDevice",
    "ptpVersion": "both",
    "category": "control",
    "parameters": [
      {"name": "ControlCode", "type": "uint32", "description": "The control/property code to actuate"},
      {"name": "FlagExtOpt", "type": "uint32", "description": "PTP3: must be 0x00000001. PTP2: not present or 0."}
    ],
    "expectedResponse": "OK",
    "usedInSABRuntime": true,
    "canCallDirectly": true,
    "requiresSession": true,
    "requiresSequence": false,
    "affectsCameraState": true,
    "risk": "safe",
    "notes": "Data = UINT32 value. PTP3 REQUIRES params=[propCode, 0x00000001] (FLAG_EXT_OPT). For BUTTON: value=0x0002 (DOWN) then 0x0001 (UP). SAB implements this correctly."
  },
  {
    "opcode": "0x9209",
    "name": "SDIO_GetAllExtDevicePropInfo",
    "ptpVersion": "both",
    "category": "property",
